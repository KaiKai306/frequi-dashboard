{
	# FreqUI uses a query token for its websocket. Do not log HTTP requests.
	log {
		exclude http.log.access http.log.error
	}
}

quant.happykai.cn {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	header X-Content-Type-Options "nosniff"
	header Strict-Transport-Security "max-age=86400"
	request_body {
		max_size 1MB
	}
	redir /preview /preview/ 308
	handle /preview/backtests/* {
		route {
			@research_write not method GET HEAD
			respond @research_write "Read-only research reports" 405
			forward_auth freqtrade:8080 {
				uri /api/v1/show_config
			}
			uri strip_prefix /preview
			header Cache-Control "no-store"
			reverse_proxy trellis-preview:8080
		}
	}
	handle_path /preview/* {
		reverse_proxy trellis-preview:8080
	}
	handle {
		reverse_proxy freqtrade:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}
	encode zstd gzip
}
